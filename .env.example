# Optional dev default. Normally the user pastes their own Client ID in the in-app setup guide
# (stored in localStorage as sm.clientId, which takes precedence over this).
# Copy to .env.local and fill in. Client ID is public (PKCE flow, no secret needed).
VITE_SPOTIFY_CLIENT_ID=

# Optional: URL of the backend worker (if used).
VITE_WORKER_URL=
